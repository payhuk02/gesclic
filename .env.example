# Supabase Configuration (public — safe in the browser)
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PROJECT_ID=your-supabase-project-id

# Temporary client-side token encryption (prefer server-side vault long-term).
# NEVER use a weak/default value in production.
VITE_ENCRYPTION_KEY=generate-a-32-char-random-secret

# Optional: default webhook HMAC fallback. Prefer per-subscription secrets in DB.
# VITE_WEBHOOK_SECRET=generate-a-32-char-random-secret

# OAuth — public client IDs only (secrets go in Supabase Edge Function secrets)
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_SALESFORCE_CLIENT_ID=

# --- Set these as Supabase secrets (NOT VITE_), e.g. supabase secrets set ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# LOVABLE_API_KEY=

# MoneyFusion Payment Gateway (Abonnements cliniques)
MONEYFUSION_API_URL="https://pay.moneyfusion.net/YOUR_APP_NAME/YOUR_APP_KEY/pay/"
VITE_MONEYFUSION_API_URL="https://pay.moneyfusion.net/YOUR_APP_NAME/YOUR_APP_KEY/pay/"
